{
  "name": "@fidscript/instant-sdk",
  "version": "0.1.1",
  "description": "FIDScript self-hosted InstantDB SDK - defaults to FIDScript infrastructure",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist; tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "mutative": "^1.0.10",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.74",
    "@types/uuid": "^10.0.0",
    "@types/websocket": "^1.0.5",
    "typescript": "^5.9.3"
  }
}
