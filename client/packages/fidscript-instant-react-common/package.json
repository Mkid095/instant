{
  "name": "@fidscript/instant-react-common",
  "version": "0.1.2",
  "description": "FIDScript shared components for React and React Native",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "tshy": {
    "selfLink": false,
    "main": true,
    "module": true,
    "project": "./tsconfig.json",
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist .tshy-build; tshy",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "dependencies": {
    "@fidscript/instant-sdk": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.6.1",
    "@types/react": ">=16",
    "tshy": "^3.0.2",
    "typescript": "^5.9.3"
  }
}
