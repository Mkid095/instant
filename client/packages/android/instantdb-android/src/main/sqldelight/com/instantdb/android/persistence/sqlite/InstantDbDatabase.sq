-- Phase 4 — SQLDelight schema for the InstantDB local store.
--
-- This schema backs the persistence SPI (`com.instantdb.poc.persistence.*`).
-- All four tables survive process death. The triple store is the source
-- of truth for the local query engine; the mutation queue is replayed
-- on reconnect; the query cache preserves last-seen results across
-- restarts; the attr catalog is rebuilt from init-ok on first connect.
--
-- Concurrency model:
--   - All writes go through a single writer (the sync engine).
--   - Reads are read-committed and never mutate.
--   - `processed_tx_id` is per-query and lets us invalidate cache entries.
--
-- Indexes:
--   - triples(attr_id)                  — AEV index (lookup by attribute)
--   - triples(eid, attr_id, value) UNIQUE — EAV index, dedup via PK
--   - triples(value, attr_id) WHERE value_type='ref' — VAE for links
--   - pending_mutations(order_index) — replay order
--   - attrs(forward_etype, forward_label) — lookup by forward-identity

CREATE TABLE triples (
  eid                   TEXT    NOT NULL,
  attr_id               TEXT    NOT NULL,
  value                 TEXT    NOT NULL, -- JSON-encoded JsonElement
  value_type            TEXT    NOT NULL DEFAULT 'blob', -- 'blob' or 'ref'
  tx_id                 INTEGER NOT NULL,
  created_at            INTEGER NOT NULL,
  PRIMARY KEY (eid, attr_id, value)
);

CREATE INDEX triples_attr_idx ON triples(attr_id);
CREATE INDEX triples_tx_idx ON triples(tx_id);
CREATE INDEX triples_value_attr_idx ON triples(value, attr_id) WHERE value_type = 'ref';

CREATE TABLE attrs (
  id                    TEXT    NOT NULL PRIMARY KEY,
  forward_id            TEXT    NOT NULL,
  forward_etype         TEXT    NOT NULL,
  forward_label         TEXT    NOT NULL,
  reverse_id            TEXT,
  reverse_etype         TEXT,
  reverse_label         TEXT,
  value_type            TEXT    NOT NULL DEFAULT 'blob',
  cardinality           TEXT    NOT NULL DEFAULT 'one',
  is_unique             INTEGER NOT NULL DEFAULT 0,
  is_indexed            INTEGER NOT NULL DEFAULT 0,
  is_required           INTEGER NOT NULL DEFAULT 0,
  inferred_types        TEXT    NOT NULL DEFAULT '[]',
  catalog               TEXT    NOT NULL DEFAULT 'user',
  metadata              TEXT    NOT NULL DEFAULT '{}'
);

CREATE INDEX attrs_forward_idx ON attrs(forward_etype, forward_label);

CREATE TABLE pending_mutations (
  event_id              TEXT    NOT NULL PRIMARY KEY,
  tx_steps              TEXT    NOT NULL,    -- JSON array of tx-steps
  tx_id                 INTEGER,            -- null until server confirms
  order_index           INTEGER NOT NULL,
  created_at            INTEGER NOT NULL,
  confirmed_at          INTEGER             -- null until confirmed
);

CREATE INDEX pending_order_idx ON pending_mutations(order_index);

CREATE TABLE query_cache (
  hash                  TEXT    NOT NULL PRIMARY KEY,
  q_json                TEXT    NOT NULL,
  result_triples        TEXT    NOT NULL,    -- JSON-encoded List<Triple>
  page_info             TEXT,               -- nullable JSON
  aggregate             TEXT,               -- nullable JSON
  processed_tx_id       INTEGER NOT NULL,
  last_accessed_at      INTEGER NOT NULL
);

CREATE INDEX query_cache_accessed_idx ON query_cache(last_accessed_at);

CREATE TABLE app_metadata (
  key   TEXT NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (key)
);

-- ----- queries -----

-- Triple store

selectAllTriples:
SELECT eid, attr_id, value, value_type, tx_id, created_at FROM triples;

selectTriplesByEntity:
SELECT eid, attr_id, value, value_type, tx_id, created_at FROM triples WHERE eid = :eid;

selectTriplesByEidAndAid:
SELECT eid, attr_id, value, value_type, tx_id, created_at FROM triples
WHERE eid = :eid AND attr_id = :aid;

selectTriplesByAid:
SELECT eid, attr_id, value, value_type, tx_id, created_at FROM triples WHERE attr_id = :aid;

selectTriplesByAidAndValue:
SELECT eid, attr_id, value, value_type, tx_id, created_at FROM triples
WHERE attr_id = :aid AND value = :value;

selectTriplesByEntities:
SELECT eid, attr_id, value, value_type, tx_id, created_at FROM triples WHERE eid IN :eids;

selectMaxTxId:
SELECT IFNULL(MAX(tx_id), 0) FROM triples;

selectCount:
SELECT COUNT(*) FROM triples;

selectAllTriplesStream:
SELECT eid, attr_id, value, value_type, tx_id, created_at FROM triples;

insertTriple:
INSERT OR REPLACE INTO triples(eid, attr_id, value, value_type, tx_id, created_at)
VALUES(?, ?, ?, ?, ?, ?);

deleteTriple:
DELETE FROM triples WHERE eid = :eid AND attr_id = :aid AND value = :value;

deleteEntity:
DELETE FROM triples WHERE eid = :eid;

-- Attr store

selectAllAttrs:
SELECT id, forward_id, forward_etype, forward_label, reverse_id, reverse_etype,
       reverse_label, value_type, cardinality, is_unique, is_indexed, is_required,
       inferred_types, catalog, metadata
FROM attrs;

selectAttrById:
SELECT id, forward_id, forward_etype, forward_label, reverse_id, reverse_etype,
       reverse_label, value_type, cardinality, is_unique, is_indexed, is_required,
       inferred_types, catalog, metadata
FROM attrs WHERE id = :id;

selectAttrByForwardIdentity:
SELECT id, forward_id, forward_etype, forward_label, reverse_id, reverse_etype,
       reverse_label, value_type, cardinality, is_unique, is_indexed, is_required,
       inferred_types, catalog, metadata
FROM attrs WHERE forward_etype = :etype AND forward_label = :label;

selectAttrsByEtype:
SELECT id, forward_id, forward_etype, forward_label, reverse_id, reverse_etype,
       reverse_label, value_type, cardinality, is_unique, is_indexed, is_required,
       inferred_types, catalog, metadata
FROM attrs WHERE forward_etype = :etype;

deleteAllAttrs:
DELETE FROM attrs;

upsertAttr:
INSERT OR REPLACE INTO attrs(id, forward_id, forward_etype, forward_label,
                             reverse_id, reverse_etype, reverse_label,
                             value_type, cardinality,
                             is_unique, is_indexed, is_required,
                             inferred_types, metadata)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAttrCount:
SELECT COUNT(*) FROM attrs;

-- Mutation store

selectPendingOrderByOrder:
SELECT event_id, tx_steps, tx_id, order_index, created_at, confirmed_at
FROM pending_mutations
ORDER BY order_index ASC;

selectPendingByEventId:
SELECT event_id, tx_steps, tx_id, order_index, created_at, confirmed_at
FROM pending_mutations
WHERE event_id = :eventId;

selectPendingCount:
SELECT COUNT(*) FROM pending_mutations;

insertPending:
INSERT OR REPLACE INTO pending_mutations(event_id, tx_steps, tx_id, order_index, created_at, confirmed_at)
VALUES(?, ?, ?, ?, ?, ?);

updatePendingTxId:
UPDATE pending_mutations SET tx_id = :txId, confirmed_at = :confirmedAt WHERE event_id = :eventId;

deletePending:
DELETE FROM pending_mutations WHERE event_id = :eventId;

deletePendingAboveTxId:
DELETE FROM pending_mutations WHERE tx_id IS NOT NULL AND tx_id <= :maxTxId;

-- Query cache

selectCachedQuery:
SELECT hash, q_json, result_triples, page_info, aggregate, processed_tx_id, last_accessed_at
FROM query_cache WHERE hash = :hash;

selectAllCachedQueries:
SELECT hash, q_json, result_triples, page_info, aggregate, processed_tx_id, last_accessed_at
FROM query_cache ORDER BY last_accessed_at ASC;

selectCachedCount:
SELECT COUNT(*) FROM query_cache;

upsertCachedQuery:
INSERT OR REPLACE INTO query_cache(hash, q_json, result_triples, page_info, aggregate,
                                    processed_tx_id, last_accessed_at)
VALUES(?, ?, ?, ?, ?, ?, ?);

touchCachedQuery:
UPDATE query_cache SET last_accessed_at = :at WHERE hash = :hash;

deleteCachedQuery:
DELETE FROM query_cache WHERE hash = :hash;