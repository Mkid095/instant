# InstantDB / FIDScript Self-Hosted Environment Variables
#
# Copy to .env and fill in real values. NEVER commit the populated .env.

# Public URLs
INSTANT_API_URI=https://apiinstant.fidscript.com
INSTANT_BACKEND_URL=https://apiinstant.fidscript.com
INSTANT_DASHBOARD_URL=https://instant.fidscript.com

# Caddy domains (only needed with docker-compose.with-caddy.yml)
DASHBOARD_DOMAIN=instant.fidscript.com
BACKEND_DOMAIN=apiinstant.fidscript.com

# Canonical domain settings (used by MCP and Android docs).
# All InstantDB clients read these — never hardcode domains in code.
INSTANT_API_HOST=https://apiinstant.fidscript.com
INSTANT_DASH_HOST=https://instant.fidscript.com
INSTANT_MAVEN_HOST=https://instant.fidscript.com/maven

# PostgreSQL
POSTGRES_PASSWORD=pass
POSTGRES_USER=instant
POSTGRES_DB=instant

# Postgres connection pool
CONNECTION_POOL_SIZE=20

# Auth / OAuth
INSTANT_SUPERUSER_EMAIL=
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID=
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth client secret should be supplied via the deploy environment, not committed.

# Email (use one of these)
STRIPE_API_KEY=
POSTMARK_TOKEN=
SENDGRID_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_USE_TLS=true

# Sender info
INSTANT_DASHBOARD_EMAIL_SENDER_NAME=
INSTANT_DASHBOARD_EMAIL_SENDER_EMAIL=
INSTANT_APP_EMAIL_SENDER_NAME=
INSTANT_APP_EMAIL_SENDER_EMAIL=
INSTANT_TEAM_EMAIL_SENDER_NAME=
INSTANT_TEAM_EMAIL_SENDER_EMAIL=
INSTANT_EMAIL_PROVIDER=
INSTANT_EMAIL_REPLY_TO=

# Storage
STORAGE_PROVIDER=minio
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CLI
INSTANT_CLI_API_URI=https://apiinstant.fidscript.com
INSTANT_CLI_DASH_URI=https://instant.fidscript.com
