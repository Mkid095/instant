# Public URLs. Change these when deploying behind a domain or proxy.
INSTANT_BACKEND_URL=http://localhost:8888
INSTANT_DASHBOARD_URL=http://localhost:3000
# S3_PUBLIC_ENDPOINT must be an origin without a path. Use a dedicated hostname or port.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Domains used by the Caddy compose file. For production, point DNS at this host
# and update the public URLs above to use these domains with https://.
# These are only required if using docker-compose.with-caddy.yml
DASHBOARD_DOMAIN=localhost
BACKEND_DOMAIN=api.localhost
STORAGE_DOMAIN=files.localhost

# Database. DATABASE_URL is inferred from these values inside docker-compose.
POSTGRES_USER=instant
POSTGRES_PASSWORD=pleasegenerateapasswordhere
POSTGRES_DB=instant
# The number of connections each instance will create to the database
# Ensure that postgres' `max_connections` is greater than CONNECTION_POOL_SIZE*<num instances>
CONNECTION_POOL_SIZE=20

# Object storage. Server AWS credentials are inferred from these MinIO values.
# Replace these before deploying.
# If using AWS S3, set MINIO_ROOT_USER to your AWS Access Key ID
# and MINIO_ROOT_PASSWORD to your AWS Secret Access Key, and
# leave S3_ENDPOINT and S3_PUBLIC_ENDPOINT blank.
MINIO_ROOT_USER=pleasegenerateauserhere
MINIO_ROOT_PASSWORD=pleasegenerateapasswordhere
S3_BUCKET=instant-bucket
S3_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1

# Storage provider. Set to "cloudinary" to use Cloudinary instead of MinIO/S3.
# When using Cloudinary, the MinIO/ S3 settings above are ignored for file storage.
STORAGE_PROVIDER=minio

# Cloudinary storage (only used when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Use a custom-built server image with modified code.
# Build with: ./build-server.sh [tag]
# Default: ghcr.io/instantdb/server:latest
INSTANT_SERVER_IMAGE=

# Optional deployment superuser. This user can manage the entire self-hosted
# deployment. Restart the server after changing it.
INSTANT_SUPERUSER_EMAIL=

# Dashboard Google login. Create a Google OAuth Web application and set its
# authorized redirect URI to ${INSTANT_BACKEND_URL}/dash/oauth/callback.
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID=
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_SECRET=

# Email. Configure one or more email providers below.
# The system will auto-detect and use the first available provider in this order:
#   1. Resend (if RESEND_API_KEY is set)
#   2. SMTP (if SMTP_HOST, SMTP_USER, SMTP_PASSWORD are set)
# 3. SendGrid (if SENDGRID_TOKEN is set and Postmark is not)
# 4. Postmark (if POSTMARK_TOKEN is set)
#
# You can force a specific provider by setting INSTANT_EMAIL_PROVIDER to one of:
# "resend", "smtp", "sendgrid", "postmark"

# --- Resend (recommended for self-hosted) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- SMTP (self-hosted email server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_USE_TLS=true

# --- SendGrid ---
SENDGRID_TOKEN=

# --- Postmark ---
POSTMARK_TOKEN=
INSTANT_EMAIL_PROVIDER=
INSTANT_EMAIL_REPLY_TO=hello@example.com
INSTANT_DASHBOARD_EMAIL_SENDER_NAME=Instant
INSTANT_DASHBOARD_EMAIL_SENDER_EMAIL=verify@example.com
INSTANT_APP_EMAIL_SENDER_NAME=Instant
INSTANT_APP_EMAIL_SENDER_EMAIL=verify@example.com
INSTANT_TEAM_EMAIL_SENDER_NAME=Instant
INSTANT_TEAM_EMAIL_SENDER_EMAIL=teams@example.com
