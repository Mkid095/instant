# Multi-stage build for self-hosted InstantDB dashboard
ARG NODE_VERSION=22.22.2-slim

FROM node:${NODE_VERSION} AS dependencies

WORKDIR /monorepo

COPY client/package.json client/pnpm-workspace.yaml client/pnpm-lock.yaml ./

# Install project dependencies with frozen lockfile for reproducible builds
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/usr/local/share/.cache/yarn \
    --mount=type=cache,target=/root/.local/share/pnpm/store \
    corepack enable pnpm && pnpm install;

FROM node:${NODE_VERSION} AS pruner

WORKDIR /monorepo

COPY --from=dependencies /monorepo/node_modules ./node_modules

COPY client ./
RUN corepack enable pnpm;
RUN pnpm turbo prune instant-www --docker

FROM node:${NODE_VERSION} AS builder
WORKDIR /monorepo
ARG NEXT_PUBLIC_SELF_HOSTED=true
ENV NEXT_PUBLIC_SELF_HOSTED=${NEXT_PUBLIC_SELF_HOSTED}
COPY --from=pruner /monorepo/out/json/ .
RUN corepack enable pnpm
RUN pnpm install

COPY --from=pruner /monorepo/out/full/ .
COPY client/tsconfig.base.json ./

RUN pnpm install

RUN pnpm turbo build

# Production runner
FROM node:${NODE_VERSION} AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_SELF_HOSTED=true
ENV NEXT_PUBLIC_SELF_HOSTED=${NEXT_PUBLIC_SELF_HOSTED}

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy the standalone output
COPY --from=builder /monorepo/www/.next/standalone ./
# Copy static assets and public files
COPY --from=builder /monorepo/www/.next/static ./www/.next/static
COPY --from=builder /monorepo/www/public ./www/public

COPY <<'EOF' /app/start.sh
#!/bin/sh
set -eu

node <<'NODE'
const fs = require('fs');

const apiURI = (
  process.env.INSTANT_API_URI ||
  process.env.INSTANT_BACKEND_URL ||
  ''
).trim();

try {
  const url = new URL(apiURI);
  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
    throw new Error('Unsupported protocol');
  }
} catch (_e) {
  console.error(
    'INSTANT_API_URI or INSTANT_BACKEND_URL must be a valid HTTP(S) URL.',
  );
  process.exit(1);
}

// Derive WebSocket URL from API URL
const wsUrl = new URL(apiURI);
wsUrl.protocol = wsUrl.protocol === 'https:' ? 'wss:' : 'ws:';
wsUrl.pathname = '/runtime/session';
wsUrl.search = '';
wsUrl.hash = '';

// Dashboard URL - use INSTANT_DASHBOARD_URL directly if set
const dashboardUrl = (
  process.env.INSTANT_DASHBOARD_URL ||
  apiURI.replace(/\/[^/]*$/, '')
).trim();

fs.writeFileSync(
  '/app/www/public/publicSelfHostedVariables.js',
  `window.__instantConfig = ${JSON.stringify({ apiURI, wsUrl: wsUrl.toString(), dashboardUrl })};\n`,
);
NODE

exec node www/server.js
EOF

RUN chmod +x /app/start.sh && chown -R nextjs:nodejs /app/www/public /app/start.sh

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["/app/start.sh"]
