FROM ghcr.io/instantdb/dashboard:latest AS base

# Copy our custom changes
COPY client/www/pages/dash/cli-setup/ /app/www/pages/dash/cli-setup/
COPY client/www/components/dash/ProfilePanel.tsx /app/www/components/dash/ProfilePanel.tsx
COPY client/www/components/dash/Auth.tsx /app/www/components/dash/Auth.tsx
COPY client/www/components/dash/MainDashLayout.tsx /app/www/components/dash/MainDashLayout.tsx
COPY client/www/pages/dash/index.tsx /app/www/pages/dash/index.tsx
COPY client/www/pages/_app.tsx /app/www/pages/_app.tsx
COPY client/www/lib/config.ts /app/www/lib/config.ts
COPY client/www/public/img/icon/logo-512.png /app/www/public/img/icon/logo-512.png
COPY client/www/public/img/nextmavens-logo.png /app/www/public/img/nextmavens-logo.png
