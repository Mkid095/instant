{$DASHBOARD_DOMAIN:localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# API and WebSocket routes — strip prefix and forward to server
	@api path /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy server:8888
	}
	@runtime path /runtime/*
	handle @runtime {
		reverse_proxy server:8888
	}
	@dashauth path /dash/auth/*
	handle @dashauth {
		reverse_proxy server:8888
	}

	reverse_proxy www:3000
}

{$BACKEND_DOMAIN:api.localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy server:8888
}


whatsapp.nextmavens.com {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@api {
		path /api/v1/*
	}
	handle @api {
		reverse_proxy platform-api:8080
	}

	reverse_proxy viventure-web:3000
}
